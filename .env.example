# Placeholders only. Do not commit issued credentials, signed proofs, or wallet keys.
GATEWAY_ENVIRONMENT=development
PAYMENT_ADAPTER=demo
X402_PAY_TO=0xYOUR_EVM_RECEIVING_ADDRESS
X402_RESOURCE_BASE_URL=https://gateway.example
# CDP auth is injected by deployment code after an authenticated /supported integration test.
X402_CDP_API_KEY_ID=replace-at-deployment
X402_CDP_API_KEY_SECRET=replace-at-deployment
# Production result-access capability key; use a deployment secret of at least
# 32 bytes. Development/test mode generates an ephemeral key automatically.
RESULT_ACCESS_TOKEN_KEY=replace-at-deployment
# CNY/JD is intentionally deferred. Leave all CLAWTIP_* values unset in this
# release; no wallet, merchant credentials, or CNY collection is enabled.
